// -----------------------------------------------------------------------------
// Polygon chain configuration
//
// Env vars that override values in this file:
//   POLYGON_RPC  — the RPC endpoint (put your paid/Alchemy URL in .env)
//
// deployBlock is auto-discovered on first scan if omitted or 0.
// -----------------------------------------------------------------------------
{
  "chain": {
    name: "Polygon",
    id: 137,
    currency: "MATIC",
    token: "0x0d500B1d8E8eF31E21C99d1Db9A6444d3ADf1270", // WMATIC
    // Free public RPC as fallback; override with POLYGON_RPC in .env
    host: "https://polygon-rpc.com",
    // Your deployed YoBatches batch reader
    contract: "0x1860a9f4661a0299A2A745c2A49DB212098414CB",
    threads: 5,
    interval: 3000,
    pagesize: 1000000
  },

  "factories": {
    "v2": {
      abi: ["event PairCreated(address indexed token0, address indexed token1, address pair, uint)"],
      // Value can be a string (just the address) OR an object with { address, deployBlock, fee }.
      // Auto-discovery will backfill deployBlock on first scan.
      list: {
        "UniSwap v2":    "0x9e5A52f57b3038F1B8EeE45F28b3C1967e22799C",
        "QuickSwap v2":  "0x5757371414417b8C6CAad45bAeF941aBc7d3Ab32",
        "SushiSwap":     "0xc35DADB65012eC5796536bD9864eD8773aBc74C4",
        "Dfyn Exchange": "0xE7Fb3e833eFE5F9c441105EB65Ef8b261266423B",
        "ApeSwap":       "0xCf083Be4164828f00cAE704EC15a36D711491284"
      }
    }
    /*
    // V3 & Algebra factories - stubbed for later.
    // These use PoolCreated instead of PairCreated, and off-chain pricing needs
    // a Quoter contract, not the pool's own reserves. Different scanner needed.

    "v3": {
      abi: ["event PoolCreated(address indexed token0,address indexed token1,uint24 indexed fee, int24 tickSpacing,address pool)"],
      list: {
        "UniSwap v3":   "0x1F98431c8aD98523631AE4a59f267346ea31F984",
        "SushiSwap v3": "0x917933899c6a5F8E37F31E19f92CdBFF7e8FF0e2"
      }
    },
    "algebra": {
      abi: ["event Pool(address indexed token0, address indexed token1, address pool)"],
      list: {
        "QuickSwap v3": "0x411b0fAcC3489691f28ad58c47006AF5E3Ab3A28"
      }
    }
    */
  },

  // Aave V3 flash loan provider on Polygon.
  // Fee is 0.05% (5 bps) as of the current governance-set FLASHLOAN_PREMIUM_TOTAL.
  // Token list here is a starter set of what Aave V3 supports on Polygon for
  // flash loans — the full set is larger; add as needed.
  "flashloan": {
    provider: "aave-v3",
    addressesProvider: "0xa97684ead0e402dc232d5a977953df7ecbab3cdb",
    premium: 0.0005,
    tokens: [
      { symbol: "USDC.e", address: "0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174", decimals:  6 },
      { symbol: "USDC",   address: "0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359", decimals:  6 },
      { symbol: "USDT",   address: "0xc2132D05D31c914a87C6611C10748AEb04B58e8F", decimals:  6 },
      { symbol: "DAI",    address: "0x8f3Cf7ad23Cd3CaDbD9735AFf958023239c6A063", decimals: 18 },
      { symbol: "WETH",   address: "0x7ceB23fD6bC0adD59E62ac25578270cFf1b9f619", decimals: 18 },
      { symbol: "WMATIC", address: "0x0d500B1d8E8eF31E21C99d1Db9A6444d3ADf1270", decimals: 18 },
