// -----------------------------------------------------------------------------
// Polygon chain configuration
//
// Env vars that override values in this file:
//   POLYGON_RPC  — the RPC endpoint (put your paid/Alchemy URL in .env)
//
// deployBlock is auto-discovered on first scan if omitted or 0.
// -----------------------------------------------------------------------------
{
  "chain": {
    name: "Polygon",
    id: 137,
    currency: "POL",  // rebranded from MATIC; same chain
    token: "0x0d500B1d8E8eF31E21C99d1Db9A6444d3ADf1270", // WPOL (formerly WMATIC)
    // Free public RPC as fallback; override with POLYGON_RPC in .env
    host: "https://polygon.drpc.org",
    // Your deployed YoBatches batch reader. Verify this is actually deployed
    // on Polygon mainnet before running reserves — the address is from the
    // scaffolded state and may need re-deployment.
    contract: "0x1860a9f4661a0299A2A745c2A49DB212098414CB",
    threads: 5,
    interval: 3000,
    pagesize: 1000000
  },

  "factories": {
    "v2": {
      abi: ["event PairCreated(address indexed token0, address indexed token1, address pair, uint)"],
      // Value can be a string (just the address) OR an object with { address, deployBlock, fee }.
      // Auto-discovery will backfill deployBlock on first scan.
      list: {
        "UniSwap v2":    "0x9e5A52f57b3038F1B8EeE45F28b3C1967e22799C",
        "QuickSwap v2":  "0x5757371414417b8C6CAad45bAeF941aBc7d3Ab32",
        "SushiSwap":     "0xc35DADB65012eC5796536bD9864eD8773aBc74C4",
        "Dfyn Exchange": "0xE7Fb3e833eFE5F9c441105EB65Ef8b261266423B",
        "ApeSwap":       "0xCf083Be4164828f00cAE704EC15a36D711491284"
      }
    }
    /*
    // V3 & Algebra factories - stubbed for later.
    // These use PoolCreated instead of PairCreated, and off-chain pricing needs
    // a Quoter contract, not the pool's own reserves. Different scanner needed.

    "v3": {
      abi: ["event PoolCreated(address indexed token0,address indexed token1,uint24 indexed fee, int24 tickSpacing,address pool)"],
      list: {
        "UniSwap v3":   "0x1F98431c8aD98523631AE4a59f267346ea31F984",
        "SushiSwap v3": "0x917933899c6a5F8E37F31E19f92CdBFF7e8FF0e2"
      }
    },
    "algebra": {
      abi: ["event Pool(address indexed token0, address indexed token1, address pool)"],
      list: {
        "QuickSwap v3": "0x411b0fAcC3489691f28ad58c47006AF5E3Ab3A28"
      }
    }
    */
  },

  // Aave V3 flash loan provider on Polygon.
  // Fee is 0.05% (5 bps) — the current governance-set FLASHLOAN_PREMIUM_TOTAL.
  // Token list is the full set of Aave V3 supported flash-loanable tokens
  // on Polygon as of user-provided reference. Also used as enumeration root
  // tokens — exotic entries (LINK, GHST, DPI, jEUR, etc.) will enumerate few
  // triangles because they're not densely paired, but they're included so
  // the executor can borrow them if a triangle does surface.
  "flashloan": {
    provider: "aave-v3",
    addressesProvider: "0xa97684ead0e402dc232d5a977953df7ecbab3cdb",
    premium: 0.0005,
    tokens: [
      // --- Stables (major) ---
      { symbol: "USDC",     address: "0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174", decimals:  6 },  // bridged (PoS)
      { symbol: "USDCn",    address: "0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359", decimals:  6 },  // native (Circle)
      { symbol: "USDT0",    address: "0xc2132D05D31c914a87C6611C10748AEb04B58e8F", decimals:  6 },
      { symbol: "DAI",      address: "0x8f3Cf7ad23Cd3CaDbD9735AFf958023239c6A063", decimals: 18 },

      // --- Native / wrapped ---
      { symbol: "WPOL",     address: "0x0d500B1d8E8eF31E21C99d1Db9A6444d3ADf1270", decimals: 18 },
      { symbol: "stMATIC",  address: "0x3A58a54C066FdC0f2D55FC9C89F0415C92eBf3C4", decimals: 18 },  // Lido-staked
      { symbol: "MaticX",   address: "0xfa68FB4628DFF1028CFEc22b4162FCcd0d45efb6", decimals: 18 },  // Stader-staked

      // --- Blue-chip bridged ---
      { symbol: "WETH",     address: "0x7ceB23fD6bC0adD59E62ac25578270cFf1b9f619", decimals: 18 },
      { symbol: "WBTC",     address: "0x1BFD67037B42Cf73acF2047067bd4F2C47D9BfD6", decimals:  8 },
      { symbol: "wstETH",   address: "0x03b54A6e9a984069379fae1a4fC4dBAE93B3bCCD", decimals: 18 },

      // --- DeFi bluechips (deeper liquidity) ---
      { symbol: "LINK",     address: "0x53E0bca35eC356BD5ddDFebbD1Fc0fD03FaBad39", decimals: 18 },
      { symbol: "AAVE",     address: "0xD6DF932A45C0f255f85145f286eA0b292B21C90B", decimals: 18 },
      { symbol: "CRV",      address: "0x172370d5Cd63279eFa6d502DAB29171933a610AF", decimals: 18 },
      { symbol: "BAL",      address: "0x9a71012B13CA4d3D0Cdc72A177DF3ef03b0E76A3", decimals: 18 },
      { symbol: "SUSHI",    address: "0x0b3F868E0BE5597D5DB7fEB59E1CADBb0fdDa50a", decimals: 18 },

      // --- Ecosystem / niche (thin markets — few triangles will enumerate) ---
      { symbol: "GHST",     address: "0x385Eeac5cB85A38A9a07A70c73e0a3271CfB54A7", decimals: 18 },
      { symbol: "DPI",      address: "0x85955046DF4668e1DD369D2DE9f3AEB98DD2A369", decimals: 18 },

      // --- Euro stables ---
      { symbol: "EURS",     address: "0xE111178A87A3BFf0c8d18DECBa5798827539Ae99", decimals:  2 },
      { symbol: "jEUR",     address: "0x4e3Decbb3645551B8A19f0eA1678079FCB33fB4c", decimals: 18 },
      { symbol: "EURA",     address: "0xE0B52e49357Fd4DAf2c15e02058DCE6BC0057db4", decimals: 18 },

      // --- MAI (miMATIC stable) ---
      { symbol: "miMATIC",  address: "0xa3Fa99A148fA48D14Ed51d610c367C61876997F1", decimals: 18 }
    ]
  }
}
