{
  // Generated by `yarn add-chain 14 flare`. RPCs come from the rated pool
  // (yarn provider flare); <SLUG>_RPC / _WS in .env are your private endpoints.
  chain: {
    id: 14,
    name: 'Flare',
    currency: 'FLR',
    // token: '0x…',   // TODO wrapped native (WFLR) — not found automatically
    // contract: '0x…',  // YoBatches2 — yarn deploy-contract flare
    // executor: '0x…',  // FlashArbExecutor — yarn deploy-flasharb flare
    threads: 10,
    interval: 3000,
    pagesize: 1000000,
  },
  reserves: {
    dust: 0,
  },
  evaluator: {
    // Denominated in chain.token. Tune after the first yarn evaluate.
    minProfitTokens: 0.001,
    minInputTokens: 0.01,
    minLiquidityTokens: 0,
  },
  // yarn find-factories flare, then paste the verified snippets here.
  factories: {
  },
  // No Aave V3 or Balancer V2 here. Morpho Blue found — free, lends only what its markets hold.
  flashloan: {
    provider: 'morpho',
    premium: 0,
    morpho: '0xF4346F5132e810f80a28487a79c7559d9797E8B0',
    tokens: [
      // TODO add flash tokens
    ],
  },
}
