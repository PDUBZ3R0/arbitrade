{
  // Generated by `yarn add-chain 34443 mode`. Registry fields (host, ws,
  // hypersyncUrl) live in @chains.json5; anything set here overrides them.
  chain: {
    id: 34443,
    name: 'Mode',
    currency: 'ETH',
    token: '0x4200000000000000000000000000000000000006',   // WETH — the numeraire for thresholds
    // contract: '0x…',  // YoBatches2 — yarn deploy-contract mode
    // executor: '0x…',  // FlashArbExecutor — yarn deploy-flasharb mode
    threads: 10,
    interval: 3000,
    pagesize: 1000000,
  },
  reserves: {
    dust: 0,
  },
  evaluator: {
    // Denominated in chain.token. Tune after the first yarn evaluate.
    minProfitTokens: 0.001,
    minInputTokens: 0.01,
    minLiquidityTokens: 0,
  },
  // yarn find-factories mode, then paste the verified snippets here.
  factories: {
  },
  // No Aave V3 market here. Balancer V2 vault found (flash fee 0.000%).
  // It can only lend what it holds — check before adding tokens.
  flashloan: {
    provider: 'balancer-v2',
    premium: 0,
    vault: '0xBA12222222228d8Ba445958a75a0704d566BF2C8',
    tokens: [
      { symbol: 'WETH', address: '0x4200000000000000000000000000000000000006', decimals: 18 },
    ],
  },
}
