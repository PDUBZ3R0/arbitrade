    id: 80094,
    name: 'Berachain',
    currency: 'BERA',
    // token: '0x…',   // TODO wrapped native (WBERA) — not found automatically
    // contract: '0x…',  // YoBatches2 — yarn deploy-contract berachain
    // executor: '0x…',  // FlashArbExecutor — yarn deploy-flasharb berachain
