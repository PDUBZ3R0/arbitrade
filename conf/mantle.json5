{
  // Generated by `yarn add-chain 5000 mantle`. RPCs come from the rated pool
  // (yarn provider mantle); <SLUG>_RPC / _WS in .env are your private endpoints.
  chain: {
    id: 5000,
    name: 'Mantle',
    currency: 'MNT',
    token: '0x78c1b0C915c4FAA5FffA6CAbf0219DA63d7f4cb8',   // WMNT — the numeraire for thresholds
    // contract: '0x…',  // YoBatches2 — yarn deploy-contract mantle
    // executor: '0x…',  // FlashArbExecutor — yarn deploy-flasharb mantle
    threads: 10,
    interval: 3000,
    pagesize: 1000000,
  },
  reserves: {
    dust: 0,
  },
  evaluator: {
    // Denominated in chain.token. Tune after the first yarn evaluate.
    minProfitTokens: 0.001,
    minInputTokens: 0.01,
    minLiquidityTokens: 0,
  },
  // yarn find-factories mantle, then paste the verified snippets here.
  factories: {
