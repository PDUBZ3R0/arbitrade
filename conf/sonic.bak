    // Shadow Exchange — the LEGACY (Solidly-family) factory only.
    //
    // This was previously commented out as "Shadow uses different maths than
    // v2". Half true, and the half that matters is fine. Read from
    // Shadow-Exchange/shadow-core, contracts/Pair.sol:
    //
    //   _k(x, y)          stable -> x3y+y3x (Solidly); else -> x * y
    //   _getAmountOut()   stable -> Newton solve via _get_y()
    //                     else   -> (amountIn * reserveB) / (reserveA + amountIn)
    //
    // The volatile branch is plain constant product, identical in form to
    // swap_output() in source/util/calculus.js. swap(), getReserves() and
    // Sync(uint112,uint112) all match UniswapV2 exactly, so the executor's
    // on-chain hop sizing and the hot loop's Sync feed need no changes at all.
    // The stable pools DO need different maths and are excluded automatically:
    // getPairsForEnumeration() drops stable = 1, exactly as it already does
    // for Equalizer's 39 stable pairs.
    //
    // FEE SOURCE — the one thing that is NOT the v2fee default.
    //
    // The v2fee group defaults to factory.pairFee(pair), and PairFactory does
    // expose that function. It is the wrong source here: createPair() calls
    // IPair(pair).setFee(fee) but never writes the factory's _pairFee mapping,
    // which only governance's setPairFee() populates. So
    // factory.pairFee(pair) returns 0 for essentially every pair, and a fee of
    // 0 makes the evaluator overstate every output and the pair's K check
    // reject every trade. The authoritative value is the pair's own zero-arg
    // fee() getter, denominated in FEE_DENOM = 1_000_000.
    //
    // Scope: this is Shadow's legacy venue only (~$1.79M TVL, ~$27k/day
    // volume). Shadow's main product is concentrated liquidity
    // (contracts/CL, a Ramses V3 fork) and is NOT reachable by this pipeline —
    // RamsesV3Pool has no getReserves() and no V2 swap(). The thin volume is
    // not purely bad news for us: ~1.5% daily turnover means these pools lag
    // the market, which is where cross-DEX spread comes from.
    //
    // VERIFY BEFORE TRUSTING: the factory address and the fee path are from
    // source reading, not from a chain call --
    //   yarn verify sonic         (factory address emits the expected event)
    //   yarn verify-fees sonic    (empirical fee per pair, as on Polygon)
    v2fee: {
      abi: [
        'event PairCreated(address indexed token0, address indexed token1, address pair, uint)',
      ],
      list: {
        'Shadow Solidly': {
          address: '0x2da25e7446a70d7be65fd4c053948becaa6374c8',
          deployBlock: 4028276,
          hasStableFlag: true,
          // See the FEE SOURCE note above: pair.fee(), not factory.pairFee(pair).
          feeTarget: 'pair',
          feeFunction: 'fee',
          feeDivisor: 1000000,
        },
      },
    },
    // Algebra Integral ("v4") concentrated-liquidity pools. Read via
    // globalState()/tickTable() (YoBatches getAlgebraState), NOT slot0. Reader
    // validated 2026-10-09 against live SwapX (0x9c2a7bb0…) and Atlantis
    // (0x06408d7a…, populated tick walk) pools. Fee = live fee() (the plugin's
    // fee for the NEXT swap), falling back to globalState.lastFee — Atlantis
    // showed fee()=90 vs lastFee=500, so lastFee alone is stale.
    //   Pools call back via algebraSwapCallback — it's in FlashArbExecutor/
    //   HopEngine, so REDEPLOY the Sonic executor before trading these live
    //   (reading/scoring works without it).
    // Set deployBlock before scanning: `yarn discover sonic <factory>`.
    // Scanning from 0 works but is slow.
    algebra: {
      list: {
        'SwapX Algebra': {
          address: '0x8121a3F8c4176E9765deEa0B95FA2BDfD3016794',
          deployBlock: 0, // TODO: set to SwapX factory's deploy block
          algebraVariant: 'integral',
        },
        'Atlantis Protocol': {
          address: '0x7C839669a12FAE0BFBE2F6a16516Dd2ADc2F1a1b',
          deployBlock: 0, // TODO: set to Atlantis factory's deploy block
          algebraVariant: 'integral',
        },
      },
    },
    solidly: {
