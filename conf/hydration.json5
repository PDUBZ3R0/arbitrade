{
  // Generated by `yarn add-chain 222222 hydration`. RPCs come from the rated pool
  // (yarn provider hydration); <SLUG>_RPC / _WS in .env are your private endpoints.
  chain: {
    id: 222222,
    name: 'Hydration',
    currency: 'WETH',
    // token: '0x…',   // TODO wrapped native (WWETH) — not found automatically
    // contract: '0x…',  // YoBatches2 — yarn deploy-contract hydration
    // executor: '0x…',  // FlashArbExecutor — yarn deploy-flasharb hydration
    threads: 10,
    interval: 3000,
    pagesize: 1000000,
  },
  reserves: {
    dust: 0,
  },
  evaluator: {
    // Denominated in chain.token. Tune after the first yarn evaluate.
    minProfitTokens: 0.001,
    minInputTokens: 0.01,
    minLiquidityTokens: 0,
  },
  // yarn find-factories hydration, then paste the verified snippets here.
  factories: {
  },
  // Aave V3 (conf/markets/aave-v3.json: hydration-lending, reserves read live from the pool).
  // Order matters: triangle roots are assigned by position — run yarn aave-reserves hydration --order-only.
  flashloan: {
    provider: 'aave-v3',
    premium: 0.0005,
    pool: '0x1b02E051683b5cfaC5929C25E84adb26ECf87B38',
    tokens: [
