{
  // Generated by `yarn add-chain 4326 megaeth`. Registry fields (host, ws,
  // hypersyncUrl) live in @chains.json5; anything set here overrides them.
  chain: {
    id: 4326,
    name: 'MegaETH',
    currency: 'ETH',
    token: '0x4200000000000000000000000000000000000006',   // WETH — the numeraire for thresholds
    // contract: '0x…',  // YoBatches2 — yarn deploy-contract megaeth
    // executor: '0x…',  // FlashArbExecutor — yarn deploy-flasharb megaeth
    threads: 10,
    interval: 3000,
    pagesize: 1000000,
  },
  reserves: {
    dust: 0,
  },
  evaluator: {
    // Denominated in chain.token. Tune after the first yarn evaluate.
    minProfitTokens: 0.001,
    minInputTokens: 0.01,
    minLiquidityTokens: 0,
  },
  // yarn find-factories megaeth, then paste the verified snippets here.
  factories: {
  },
  // Also here: Balancer V2 vault (flash fee 0.000%).
  //   { symbol: …, address: …, decimals: …, provider: 'balancer-v2' }
  // Aave V3 (Ink V3 Market.json, reserves read live from the pool).
  // Order matters: triangle roots are assigned by position — run yarn aave-reserves megaeth --order-only.
  flashloan: {
  "provider": "aave-v3",
  "premium": 0.0005,
  "tokens": [
    {
      "symbol": "WETH",
      "address": "0x4200000000000000000000000000000000000006",
      "decimals": 18
    },
    {
      "symbol": "BTCb",
      "address": "0xB0F70C0bD6FD87dbEb7C10dC692a2a6106817072",
      "decimals": 8
    },
    {
      "symbol": "USDT0",
      "address": "0xB8CE59FC3717ada4C02eaDF9682A9e934F625ebb",
      "decimals": 6
    },
    {
      "symbol": "USDm",
      "address": "0xFAfDdbb3FC7688494971a79cc65DCa3EF82079E7",
      "decimals": 18
    },
    {
      "symbol": "wstETH",
      "address": "0x601aC63637933D88285A025C685AC4e9a92a98dA",
      "decimals": 18
    },
    {
      "symbol": "wrsETH",
      "address": "0x4Fc44BE15e9B6E30C1E774E2C87A21D3E8b5403F",
      "decimals": 18
    },
    {
      "symbol": "ezETH",
      "address": "0x09601A65e7de7BC8A19813D263dD9E98bFdC3c57",
      "decimals": 18
    },
    {
      "symbol": "USDe",
