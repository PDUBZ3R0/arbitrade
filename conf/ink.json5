  // Tydro is an Aave v3 white-label on Ink (docs/Contract Addresses _ Tydro Documentation.pdf,
  // ~$133M TVL). The Aave venue liquidates it as-is — its Pool is the same address as
  // flashloan.pool below. USD prices come from TydroOracle automatically via the Pool's
  // PoolAddressesProvider.getPriceOracle, so no liquidation.usdOracle is needed.
  //   yarn liq-watch ink --venue aave --follow --liquidate
  // If the built-in `ink` Aave subgraph refuses as indexing a different pool, seed from the
  // deploy block with `--seed hypersync` (ENVIO_API_TOKEN) or `--seed rpc`.
  liquidation: {
    pool: "0x2816cf15F6d2A220E789aA011D5EE4eB6c47FEbA",   // Tydro Pool
  },


  // Chain-tuned evaluator defaults (piece 5) — absolute floors in whole
  // tokens, not fractions. WETH is expensive, so 0.001 (~a couple dollars at
  // typical prices) is a meaningful minimum profit/liquidity floor here.
  // Override per-run with --min-profit-tokens etc.
  evaluator: {
    minProfitTokens: 0.00001,
    minLiquidityTokens: 0.0001,
    minInputTokens: 0.00001,
  },
  // Reserves-stage dust threshold (piece 4) — same numeraire conversion as
  // `evaluator` above, but deliberately looser: this flags factories as
  // DEAD/THIN, not "below a viable trade size". Override with `--dust`.
  reserves: {
    dust: 0.0001,
  },
