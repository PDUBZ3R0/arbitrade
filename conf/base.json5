  // Chain-tuned evaluator defaults (piece 5) — absolute floors in whole
  // tokens, not fractions. WETH is expensive, so 0.001 (~a couple dollars at
  // typical prices) is a meaningful minimum profit/liquidity floor here.
  // Override per-run with --min-profit-tokens etc.
  evaluator: {
    minProfitTokens: 0.001,
    minLiquidityTokens: 0.001,
    minInputTokens: 0.001,
  },
  // Reserves-stage dust threshold (piece 4) — same numeraire conversion as
  // `evaluator` above, but deliberately looser: this flags factories as
  // DEAD/THIN, not "below a viable trade size". Override with `--dust`.
  reserves: {
    dust: 0.0001,
    // Uniswap V3 alone has ~1.9M pools here; getV3State on all of them is
    // ~19k eth_calls. The prefilter reads only pools a triangle can reach:
    // root pools holding at least this much of their root (in that root's
    // own units — 0.05 WETH, 0.05 USDC, 0.05 cbBTC...), and pools between
    // tokens that have one. Raise it if reserves is still slow; 0 = only
    // empty pools drop.
    v3MinRootBalance: 0.05,
  },
