    //       0xc7a590291e07b9fe9e64b86c58fd8fc764308c4a (38) — the KyberSwap
    //       Elastic factory address, which uses its own state layout and was
    //       deprecated after the Nov 2023 exploit.
    // Not looked at: ~2,100 smaller candidates beyond --verify-limit 75 (all <20 pools).
  },

