  // Chain-tuned evaluator defaults (piece 5) — absolute floors in whole
  // tokens, not fractions. WXDAI is ~$1, so 0.10 is a meaningful minimum
  // profit/liquidity floor here without needing a USD price oracle. Applies
  // the same fraction to every root token on this chain (WETH, GNO, etc.) —
  // for a non-stablecoin root that's a different real dollar floor; override
  // per-run with --min-profit-tokens etc. if you want per-root precision.
  evaluator: {
    minProfitTokens: 0.10,
    minLiquidityTokens: 0.10,
    minInputTokens: 0.10,
  },
  // Reserves-stage dust threshold (piece 4) — same numeraire conversion as
  // `evaluator` above, but deliberately looser: this flags factories as
  // DEAD/THIN, not "below a viable trade size". Override with `--dust`.
  reserves: {
    dust: 0.01,
  },
}
