{
  // Generated by `yarn add-chain 204 opbnb`. RPCs come from the rated pool
  // (yarn provider opbnb); <SLUG>_RPC / _WS in .env are your private endpoints.
  chain: {
    id: 204,
    name: 'opBNB',
    currency: 'BNB',
    token: '0x4200000000000000000000000000000000000006',   // WBNB — the numeraire for thresholds
    // contract: '0x…',  // YoBatches2 — yarn deploy-contract opbnb
    // executor: '0x…',  // FlashArbExecutor — yarn deploy-flasharb opbnb
    threads: 10,
    interval: 3000,
    pagesize: 1000000,
  },
  reserves: {
    dust: 0,
  },
  evaluator: {
    // Denominated in chain.token. Tune after the first yarn evaluate.
    minProfitTokens: 0.001,
    minInputTokens: 0.01,
    minLiquidityTokens: 0,
  },
  // yarn find-factories opbnb, then paste the verified snippets here.
  factories: {
  },
  // Aave V3 (conf/markets/aave-v3.json: kinza, reserves read live from the pool).
  // Order matters: triangle roots are assigned by position — run yarn aave-reserves opbnb --order-only.
  flashloan: {
    provider: 'aave-v3',
    premium: 0.0005,
    pool: '0x3Aadc38eBAbD6919Fbd00C118Ae6808CBfE441CB',
    tokens: [
      { symbol: 'WBNB', address: '0x4200000000000000000000000000000000000006', decimals: 18 },
      { symbol: 'USDT', address: '0x9e5AAC1Ba1a2e6aEd6b32689DFcF62A509Ca96f3', decimals: 18 },
    ],
  },
}
