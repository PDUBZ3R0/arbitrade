{
  "name": "arbitrade",
  "version": "0.2.0",
  "description": "Flash-loan-powered multi-DEX triangular arbitrage bot",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "preinstall": "npm install -g json5",
    "deploy-contract": "sh scripts/deploy.sh",
    "deploy-flasharb": "sh scripts/deploy-flasharb.sh",
    "discover": "sh scripts/log.sh source/util discover-deploy-block",
    "verify": "sh scripts/log.sh source/util verify-factory",
    "verify-fees": "sh scripts/log.sh source verify-fees",
    "factories": "sh scripts/log.sh source/util find-factories",
    "scan": "sh scripts/log.sh source scan",
    "reserves": "sh scripts/log.sh source reserves",
    "tokens": "sh scripts/log.sh source tokens",
    "triangles": "sh scripts/log.sh source triangles",
    "evaluate": "sh scripts/log.sh source evaluate",
    "orchestrator": "sh scripts/log.sh source orchestrator",
    "cleanup": "sh scripts/log.sh source db-clean",
    "manual": "sh scripts/manual.sh",
    "pretty-print": "bash scripts/pretty.sh print",
    "pretty-commit": "bash scripts/pretty.sh commit",
    "decompile": "bash scripts/decompile.sh"
  },
  "dependencies": {
    "@envio-dev/hypersync-client": "^1.4.0",
    "@nomicfoundation/hardhat-verify": "^3.1.0",
    "@nomicfoundation/ignition-core": "^3.1.9",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "json5": "^2.2.3",
    "sevm": "^0.7.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.0.0",
    "@nomicfoundation/hardhat-ignition-viem": "^3.0.0",
    "@nomicfoundation/hardhat-viem": "^3.0.0",
    "hardhat": "^3.0.0",
    "viem": "^2.0.0"
  }
