{
  "name": "arbitrade",
  "version": "0.2.0",
  "description": "Flash-loan-powered multi-DEX triangular arbitrage bot",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "scan": "node --experimental-strip-types --disable-warning=ExperimentalWarning source/scan.ts",
    "reserves": "node --experimental-strip-types --disable-warning=ExperimentalWarning source/reserves.ts",
    "triangles": "node --experimental-strip-types --disable-warning=ExperimentalWarning source/triangles.ts",
    "evaluate": "node --experimental-strip-types --disable-warning=ExperimentalWarning source/evaluate.ts",
    "db-clean": "node --experimental-strip-types --disable-warning=ExperimentalWarning source/db-clean.ts",
    "discover-block": "node --experimental-strip-types --disable-warning=ExperimentalWarning source/util/discover-deploy-block.ts",
    "verify-factory": "node --experimental-strip-types --disable-warning=ExperimentalWarning source/util/verify-factory.ts",
    "find-factories": "node --experimental-strip-types --disable-warning=ExperimentalWarning source/util/find-factories.ts",
    "manual": "sh scripts/manual.sh",
    "apply": "sh scripts/apply-tar.sh",
    "sync": "sh scripts/sync.sh"
  },
  "dependencies": {
    "@envio-dev/hypersync-client": "^1.4.0",
