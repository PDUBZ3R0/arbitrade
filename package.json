{
  "name": "arbitrade",
  "version": "0.2.0",
  "description": "Flash-loan-powered multi-DEX triangular arbitrage bot",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "aws": "aws ssm start-session --target i-0883e3a47cc9fc6c1",
    "aws-push-db": "bash scripts/aws/push-db.sh",
    "aws-push-env": "bash scripts/aws/push-env.sh",
    "all": "bash scripts/all.sh _",
    "arbitrage": "bash scripts/all.sh A",
    "liquidate": "bash scripts/all.sh L",
    "add-chain": "bash scripts/log.sh source add-chain",
    "factories": "bash scripts/log.sh source/util find-factories",
    "deploy": "bash scripts/deploy.sh",
    "contract-update": "bash scripts/log.sh source/util contract-update",
    "configure": "bash scripts/init.sh",
    "cleanup": "bash scripts/log.sh source db-clean",
    "verify-fees": "bash scripts/log.sh source verify-fees",
    "check-fees": "bash scripts/log.sh source check-fee-config",
    "scan": "bash scripts/log.sh source scan",
    "reserves": "bash scripts/log.sh source reserves",
    "tokens": "bash scripts/log.sh source tokens",
    "probe": "bash scripts/log.sh source probe",
    "triangles": "bash scripts/log.sh source triangles",
    "evaluate": "bash scripts/log.sh source evaluate",
    "hot": "bash scripts/log.sh source hot",
    "liq": "bash scripts/log.sh source liq-watch",
    "discover": "bash scripts/log.sh source/util discover-deploy-block",
    "verify-factory": "bash scripts/log.sh source/util verify-factory",
    "verify-markets": "bash scripts/log.sh source verify-markets",
    "market": "bash scripts/market.sh",
    "pretty": "bash scripts/pretty.sh",
    "provider": "bash scripts/vet.sh",
    "bigblocks": "node scripts/hyperevm-bigblocks.mjs",
    "build-vps": "git pull && cp dist/vps/* . && docker compose build && docker compose up -d",
    "deploy-vps": "ssh arb 'cd /opt/arbitrade && yarn build-vps'"
  },
  "dependencies": {
    "@envio-dev/hypersync-client": "^1.4.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "json5": "^2.2.3",
    "sevm": "^0.7.4",
    "vetted-provider": "^0.1.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.0.0",
    "@nomicfoundation/hardhat-ignition-viem": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^3.1.0",
    "@nomicfoundation/hardhat-viem": "^3.0.0",
    "@nomicfoundation/ignition-core": "^3.1.9",
    "hardhat": "^3.0.0",
    "solc": "^0.8.37",
    "solc0815": "npm:solc@0.8.15",
    "solc0819": "npm:solc@0.8.19",
    "viem": "^2.0.0"
  }
}
