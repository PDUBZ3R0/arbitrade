{
  "name": "arbitrade",
  "version": "0.2.0",
  "description": "Flash-loan-powered multi-DEX triangular arbitrage bot",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "aws": "aws ssm start-session --target i-0883e3a47cc9fc6c1",
    "aws-push-env": "bash scripts/aws/push-env.sh",
    "aws-push-db": "bash scripts/aws/push-db.sh",
    "preinstall": "npm install -g json5",
    "deploy": "HYPERLIQUID_RPC='https://rpc.hyperliquid.xyz/evm' bash scripts/deploy.sh",
    "deploy-all": "HYPERLIQUID_RPC='https://rpc.hyperliquid.xyz/evm' bash scripts/deploy.sh all",
    "deploy-contract": "HYPERLIQUID_RPC='https://rpc.hyperliquid.xyz/evm' bash scripts/deploy.sh contract",
    "deploy-flasharb": "HYPERLIQUID_RPC='https://rpc.hyperliquid.xyz/evm' bash scripts/deploy.sh flasharb",
    "deploy-liquidator": "HYPERLIQUID_RPC='https://rpc.hyperliquid.xyz/evm' bash scripts/deploy.sh liquidator",
    "deploy-probe": "HYPERLIQUID_RPC='https://rpc.hyperliquid.xyz/evm' bash scripts/deploy.sh probe",
    "contract-update": "bash scripts/log.sh source/util contract-update",
    "discover": "bash scripts/log.sh source/util discover-deploy-block",
    "verify": "bash scripts/log.sh source/util verify-factory",
    "add-chain": "bash scripts/log.sh source add-chain",
    "configure": "bash scripts/init.sh",
    "verify-fees": "bash scripts/log.sh source verify-fees",
    "check-fee-config": "bash scripts/log.sh source check-fee-config",
    "factories": "bash scripts/log.sh source/util find-factories",
    "scan": "bash scripts/log.sh source scan",
    "reserves": "bash scripts/log.sh source reserves",
    "tokens": "bash scripts/log.sh source tokens",
    "triangles": "bash scripts/log.sh source triangles",
    "evaluate": "bash scripts/log.sh source evaluate",
    "orchestrator": "bash scripts/log.sh source orchestrator",
    "hot": "bash scripts/log.sh source hot",
    "probe": "bash scripts/log.sh source probe",
    "aave-reserves": "bash scripts/log.sh source aave-reserves",
    "aave-market": "bash scripts/log.sh source aave-market",
    "morpho-market": "bash scripts/log.sh source morpho-market",
    "cleanup": "bash scripts/log.sh source db-clean",
    "all": "bash scripts/all.sh",
    "manual": "bash scripts/manual.sh",
    "liquidator": "bash scripts/log.sh source liq-watch",
    "bigblocks": "node scripts/hyperevm-bigblocks.mjs",
    "pretty-print": "bash scripts/pretty.sh print",
    "pretty-commit": "bash scripts/pretty.sh commit"
  },
  "dependencies": {
    "@envio-dev/hypersync-client": "^1.4.0",
    "@nomicfoundation/hardhat-verify": "^3.1.0",
    "@nomicfoundation/ignition-core": "^3.1.9",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "json5": "^2.2.3",
    "sevm": "^0.7.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.0.0",
    "@nomicfoundation/hardhat-ignition-viem": "^3.0.0",
    "@nomicfoundation/hardhat-viem": "^3.0.0",
    "anvil": "^0.0.6",
    "anvil-cli": "^0.1.2",
    "formidable": "^3.5.4",
    "glob": "^13.0.6",
    "graceful-fs": "^4.2.11",
    "hardhat": "^3.0.0",
    "minimatch": "^10.2.6",
    "solc": "^0.8.37",
    "superagent": "^10.4.1",
    "viem": "^2.0.0"
  }
}
