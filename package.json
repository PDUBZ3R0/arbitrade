{
  "name": "arbitrade",
  "version": "0.2.0",
  "description": "Flash-loan-powered multi-DEX triangular arbitrage bot",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "scan": "sh scripts/log.sh source scan",
    "reserves": "sh scripts/log.sh source reserves",
    "tokens": "sh scripts/log.sh source tokens",
    "triangles": "sh scripts/log.sh source triangles",
    "evaluate": "sh scripts/log.sh source evaluate",
    "db-clean": "sh scripts/log.sh source db-clean",
    "discover-block": "sh scripts/log.sh source/util discover-deploy-block",
    "verify-factory": "sh scripts/log.sh source/util verify-factory",
    "find-factories": "sh scripts/log.sh source/util find-factories",
    "manual": "fff(){ yarn scan $1 && yarn reserves $1 && yarn tokens $1 && yarn triangles $1 && yarn evaluate $1; }; fff",
    "pretty-print": "bash scripts/pretty.sh print",
    "pretty-commit": "bash scripts/pretty.sh commit"
  },
  "dependencies": {
    "@envio-dev/hypersync-client": "^1.4.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.0.0",
    "@nomicfoundation/hardhat-ignition-viem": "^3.0.0",
    "@nomicfoundation/hardhat-viem": "^3.0.0",
    "hardhat": "^3.0.0",
    "viem": "^2.0.0"
  }
}
